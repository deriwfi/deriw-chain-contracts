		"userdoc": {
			"kind": "user",
			"methods": {
				"amountStaked(address)": {
					"notice": "Get the amount staked of the given staker"
				},
				"currentChallenge(address)": {
					"notice": "Get the current challenge of the given staker"
				},
				"getNode(uint64)": {
					"notice": "Get the Node for the given index."
				},
				"getNodeCreationBlockForLogLookup(uint64)": {
					"notice": "Returns the block in which the given node was created for looking up its creation event. Unlike the Node's createdAtBlock field, this will be the ArbSys blockNumber if the host chain is an Arbitrum chain. That means that the block number returned for this is usable for event queries. This function will revert if the given node number does not exist."
				},
				"getStaker(address)": {
					"notice": "Retrieves stored information about a requested staker"
				},
				"getStakerAddress(uint64)": {
					"notice": "Get the address of the staker at the given index"
				},
				"isStaked(address)": {
					"notice": "Check whether the given staker is staked"
				},
				"isStakedOnLatestConfirmed(address)": {
					"notice": "Check whether the given staker is staked on the latest confirmed node, which includes if the staker is staked on a descendent of the latest confirmed node."
				},
				"latestStakedNode(address)": {
					"notice": "Get the latest staked node of the given staker"
				},
				"nodeHasStaker(uint64,address)": {
					"notice": "Check if the specified node has been staked on by the provided staker. Only accurate at the latest confirmed node and afterwards."
				},
				"withdrawableFunds(address)": {
					"notice": "Get the amount of funds withdrawable by the given address"
				},
				"zombieAddress(uint256)": {
					"notice": "Get the original staker address of the zombie at the given index"
				},
				"zombieLatestStakedNode(uint256)": {
					"notice": "Get Latest node that the given zombie at the given index is staked on"
				}
			},
			"version": 1
		}
